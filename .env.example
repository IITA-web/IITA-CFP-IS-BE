# In production, set IITA_CFP_DATA_DIR to the host's persistent disk mount (for example /data).
IITA_CFP_DATA_DIR=./
IITA_CFP_DATABASE=./iita_cfp_app.db
IITA_CFP_SEEN_DATABASE=./iita_cfp_seen.db
IITA_CFP_SCRAPER_CONFIG=./scraper_config.json
IITA_CFP_ALLOWED_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=

# Protect scanner configuration edits and email delivery actions. Set a long random value in backend/.env.
IITA_CFP_ADMIN_TOKEN=replace-with-a-long-random-token
